@model EventDetail
@{ ViewData["Title"] = Model.Name; ViewData["Eyebrow"] = "Event"; }
<div class="page-head">
  <div><h2>@Model.Name</h2><p><span class="badge badge-gold" style="margin-right:8px">@Model.Type</span> @UiHelpers.DateRange(Model.StartDate, Model.EndDate) · @(Model.Location ?? "Location TBC")</p></div>
  <div class="page-actions">
    @if (Me.CanWrite){<a asp-controller="Leads" asp-action="Create" asp-route-eventId="@Model.Id" class="btn btn-outline"><i class="bi bi-person-plus"></i> Add lead</a>}
    @if (Model.CanEdit)
    {
      <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline"><i class="bi bi-pencil"></i> Edit</a>
      <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="inline-form" data-confirm="Delete this event?"><button type="submit" class="btn btn-danger-outline"><i class="bi bi-trash"></i> Delete</button></form>
    }
  </div>
</div>
<div class="grid grid-4" style="margin-bottom:20px">
  <div class="card kpi"><span class="kpi-label">Registered</span><div class="kpi-value">@Model.Registered</div></div>
  <div class="card kpi"><span class="kpi-label">Qualified+</span><div class="kpi-value">@Model.QualifiedLeads</div></div>
  <div class="card kpi"><span class="kpi-label">Pipeline value</span><div class="kpi-value">@UiHelpers.MoneyShort(Model.PipelineValue)</div></div>
  <div class="card kpi"><span class="kpi-label">@(Model.DaysToGo.HasValue ? "Days to go" : "Status")</span><div class="kpi-value">@(Model.DaysToGo?.ToString() ?? "Past")</div></div>
</div>
<div class="grid grid-12">
  <div class="card span-4"><div class="card-head"><h3>About</h3></div><div class="card-pad" style="white-space:pre-wrap;font-size:13.5px">@(string.IsNullOrEmpty(Model.Description) ? "No description yet." : Model.Description)</div></div>
  <div class="card span-8">
    <div class="card-head"><h3>Recent registrations</h3><a asp-controller="Leads" asp-action="Index" asp-route-eventId="@Model.Id" class="btn btn-ghost btn-sm">View all</a></div>
    @if (Model.RecentLeads.Count == 0){<div class="empty-state"><i class="bi bi-people"></i><h4>No registrations yet</h4></div>}
    else
    {
      <div class="table-wrap"><table><thead><tr><th>Lead</th><th>Company</th><th>Stage</th></tr></thead><tbody>
      @foreach (var l in Model.RecentLeads)
      {
        <tr class="row-link" data-href="@Url.Action("Details", "Leads", new { id = l.Id })"><td><div class="cell-name"><span class="avatar">@UiHelpers.Initials(l.FullName)</span><div><strong>@l.FullName</strong><span>@l.JobTitle</span></div></div></td><td class="text-muted">@l.CompanyName</td><td><span class="badge @UiHelpers.StageBadge(l.Stage)">@l.Stage.Label()</span></td></tr>
      }
      </tbody></table></div>
    }
  </div>
</div>
