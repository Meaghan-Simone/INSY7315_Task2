@model FormConnectionDetail
@{
    ViewData["Title"] = Model.Name; ViewData["Eyebrow"] = "Form integration";
    var preview = ViewBag.Preview as FormPreviewResult; string? sample = ViewBag.SamplePayload as string;
    bool local = Model.WebhookUrl.Contains("://localhost") || Model.WebhookUrl.Contains("://127.0.0.1");
    var script = @"// Uncovering Greatness CRM: sends every response of this Google Form to the CRM.
// 1) In your form open the three-dot menu > Script editor, replace everything with this and save.
// 2) Run setup() once from the editor and approve the permissions. That's it.
var WEBHOOK_URL = '" + Model.WebhookUrl + @"';

function setup() {
  ScriptApp.getProjectTriggers().forEach(function (t) { ScriptApp.deleteTrigger(t); });
  ScriptApp.newTrigger('onFormSubmit').forForm(FormApp.getActiveForm()).onFormSubmit().create();
}

function onFormSubmit(e) {
  var fields = e.response.getItemResponses().map(function (r) {
    return { label: r.getItem().getTitle(), type: 'GOOGLE_FORM', value: r.getResponse() };
  });
  var email = e.response.getRespondentEmail();
  if (email) fields.push({ label: 'Email', type: 'INPUT_EMAIL', value: email });
  UrlFetchApp.fetch(WEBHOOK_URL, {
    method: 'post', contentType: 'application/json', muteHttpExceptions: true,
    payload: JSON.stringify({ source: 'google-forms', submissionId: e.response.getId(),
                              formName: FormApp.getActiveForm().getTitle(), fields: fields })
  });
}";
    string StatusBadge(SubmissionStatus s) => s switch { SubmissionStatus.Created => "badge-green", SubmissionStatus.Duplicate => "badge-blue", SubmissionStatus.Rejected => "badge-amber", _ => "badge-red" };
}
<div class="page-head">
  <div><h2>@Model.Name</h2><p>@(Model.Provider == FormProvider.GoogleForms ? "Google Forms" : Model.Provider.Label()) · @(Model.IsActive ? "Active" : "Paused") · @(Model.EventName ?? "no event linked") · leads go to <strong>@(Model.Assignment switch { AssignmentMode.RoundRobin => "the whole team in turn", AssignmentMode.LeastBusy => "whoever is least busy", _ => Model.AssignToUserName ?? "one person" })</strong></p></div>
  <div class="page-actions">
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline"><i class="bi bi-pencil"></i> Edit</a>
    <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="inline-form" data-confirm="Delete this connection? Leads it already created are kept."><button class="btn btn-danger-outline" type="submit"><i class="bi bi-trash"></i></button></form>
  </div>
</div>

<div class="grid grid-4" style="margin-bottom:20px">
  <div class="card kpi"><span class="kpi-label">Received</span><div class="kpi-value">@Model.TotalReceived</div></div>
  <div class="card kpi"><span class="kpi-label">Leads created</span><div class="kpi-value">@Model.TotalCreated</div></div>
  <div class="card kpi"><span class="kpi-label">Duplicates</span><div class="kpi-value">@Model.TotalDuplicate</div></div>
  <div class="card kpi"><span class="kpi-label">Rejected / errors</span><div class="kpi-value" style="color:@(Model.TotalFailed > 0 ? "var(--red-600)" : "inherit")">@Model.TotalFailed</div></div>
</div>

<div class="grid grid-12" style="margin-bottom:20px">
  <div class="card span-7">
    <div class="card-head"><div><h3>1. Webhook URL</h3><p>Private to this connection. Anyone with the link can submit leads, so don't share it.</p></div></div>
    <div class="card-pad">
      @if (local){<div class="flash info"><i class="bi bi-info-circle"></i> This address is on your own computer, so Tally and Google can't reach it. Deploy the CRM on a public HTTPS address (and set <code>App:PublicBaseUrl</code>), or use a tunnel such as ngrok while testing.</div>}
      <div style="display:flex;gap:8px;margin-bottom:10px"><input type="text" id="webhookUrl" value="@Model.WebhookUrl" readonly style="font-family:'IBM Plex Mono',monospace;font-size:12.5px"><button type="button" class="btn btn-outline btn-sm" data-copy="webhookUrl" data-keep>Copy</button></div>
      <form asp-action="Rotate" asp-route-id="@Model.Id" method="post" data-confirm="Issue a new URL? The current one stops working immediately and must be updated in your form tool."><button class="btn btn-ghost btn-sm" type="submit"><i class="bi bi-arrow-repeat"></i> Generate a new URL</button></form>
      <div class="divider"></div>
      <p class="text-muted" style="font-size:12.5px;margin:0">Signing secret: <strong>@(Model.HasSigningSecret ? "set — unsigned requests are rejected" : "not set")</strong>. Submissions are de-duplicated by the form's response id and by email address.</p>
    </div>
  </div>
  <div class="card span-5">
    <div class="card-head"><h3>2. Connect your form</h3></div>
    <div class="card-pad" style="font-size:13.5px">
      @if (Model.Provider == FormProvider.Tally)
      {
        <ol style="padding-left:18px;margin:0;line-height:1.7">
          <li>Open your form in Tally → <strong>Integrations</strong> → <strong>Webhooks</strong> → Connect.</li>
          <li>Paste the webhook URL above as the endpoint.</li>
          <li>Recommended: switch on <strong>Signing secret</strong>, choose a secret, and enter the same secret under Edit here.</li>
          <li>Make sure the form has an email question, publish, then submit a test response.</li>
        </ol>
      }
      else if (Model.Provider == FormProvider.GoogleForms)
      {
        <p style="margin-top:0">Google Forms can't call webhooks by itself, so paste this small script into the form. It sends each response to the CRM the moment it is submitted.</p>
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:6px"><strong style="font-size:12.5px">Apps Script</strong><button type="button" class="btn btn-outline btn-sm" data-copy="gsScript" data-keep>Copy script</button></div>
        <textarea id="gsScript" readonly rows="10" style="font-family:'IBM Plex Mono',monospace;font-size:11.5px;width:100%">@script</textarea>
        <p class="text-muted" style="font-size:12px;margin:8px 0 0">Turn on “Collect email addresses” in the form settings (or add an Email question) so each lead has an email.</p>
      }
      else
      {
        <p style="margin-top:0">Send a <code>POST</code> with JSON to the URL above. Any of these shapes work:</p>
        <pre style="background:var(--surface-2);padding:10px;border-radius:8px;font-size:11.5px;overflow:auto;margin:0">{ "submissionId": "abc123",
  "fields": [ { "label": "Email", "value": "jane@acme.co" },
              { "label": "Name",  "value": "Jane Dlamini" } ] }

{ "Email": "jane@acme.co", "Name": "Jane Dlamini" }</pre>
      }
    </div>
  </div>
</div>

<div class="card" style="margin-bottom:20px">
  <div class="card-head"><div><h3>3. Test how a submission is read</h3><p>Paste a sample payload (Tally shows one after a test submission). Nothing is saved.</p></div></div>
  <form asp-action="Preview" asp-route-id="@Model.Id" method="post" class="card-pad" novalidate>
    <div class="field"><textarea name="Payload" rows="6" style="font-family:'IBM Plex Mono',monospace;font-size:12px" maxlength="100000" placeholder='{ "fields": [ { "label": "Email", "value": "jane@acme.co" }, { "label": "Name", "value": "Jane Dlamini" } ] }'>@sample</textarea></div>
    <button type="submit" class="btn btn-outline btn-sm"><i class="bi bi-eye"></i> Preview mapping</button>
    @if (preview != null)
    {
      <div class="divider"></div>
      @if (preview.Error != null){<div class="flash error"><i class="bi bi-exclamation-circle"></i> @preview.Error</div>}
      else
      {
        <div class="flash @(preview.WouldCreate ? "success" : preview.ExistingLeadId.HasValue ? "info" : "error")" style="margin-bottom:12px">
          @if (preview.WouldCreate){<text>This would <strong>create a new lead</strong>.</text>}
          else if (preview.ExistingLeadId.HasValue){<text>A lead with this email already exists (<a asp-controller="Leads" asp-action="Details" asp-route-id="@preview.ExistingLeadId" style="text-decoration:underline">open</a>): the submission would be added to its activity.</text>}
          else {<text>This would be <strong>rejected</strong> (no valid email).</text>}
        </div>
        <dl class="kv">@foreach (var kv in preview.Fields){<dt>@kv.Key</dt><dd>@kv.Value</dd>}</dl>
        @if (preview.Unmapped.Count > 0){<p class="text-muted" style="font-size:12.5px;margin:12px 0 4px">Kept in the lead's activity, not mapped to a field:</p><ul style="margin:0;padding-left:18px;font-size:12.5px">@foreach (var u in preview.Unmapped){<li>@u</li>}</ul>}
        @foreach (var w in preview.Warnings){<p style="color:var(--amber-600);font-size:12.5px;margin:8px 0 0"><i class="bi bi-exclamation-triangle"></i> @w</p>}
      }
    }
  </form>
</div>

<div class="card">
  <div class="card-head"><div><h3>Recent submissions</h3><p>The last 50. Only a name and email summary is kept, never the full form answers.</p></div></div>
  @if (Model.Submissions.Count == 0){<div class="empty-state"><i class="bi bi-inbox"></i><h4>Nothing received yet</h4><p>Submit your form once to test the connection.</p></div>}
  else
  {
    <div class="table-wrap"><table><thead><tr><th>When</th><th>Result</th><th>Submitter</th><th>Lead</th><th>Note</th></tr></thead><tbody>
    @foreach (var s in Model.Submissions)
    {
      <tr><td class="text-muted" style="white-space:nowrap">@UiHelpers.RelativeUtc(s.ReceivedUtc)</td><td><span class="badge @StatusBadge(s.Status)">@s.Status.Label()</span></td>
        <td>@s.Summary</td><td>@if (s.LeadId.HasValue){<a asp-controller="Leads" asp-action="Details" asp-route-id="@s.LeadId" style="text-decoration:underline">@s.LeadName</a>}else{<text>—</text>}</td><td class="text-muted" style="max-width:320px">@s.Error</td></tr>
    }
    </tbody></table></div>
  }
</div>
