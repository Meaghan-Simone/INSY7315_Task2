@model FormConnectionInput
@{ ViewData["Title"] = "Connect a form"; ViewData["Eyebrow"] = "Integrations"; ViewData["ShowSearch"] = false; }
<div class="content-narrow"><form asp-action="Create" method="post" class="card" novalidate autocomplete="off">
  <partial name="_Form" model="Model" />
  <div class="form-actions"><button type="submit" class="btn btn-green"><i class="bi bi-plug"></i> Connect form</button><a asp-action="Index" class="btn btn-ghost">Cancel</a></div>
</form></div>
