@model LeadDetail
@{
    ViewData["Title"] = Model.FullName; ViewData["Eyebrow"] = "Lead";
    var users = (List<UserOption>)ViewBag.Users;
    string IconFor(ActivityType t) => t switch { ActivityType.CallLogged => "bi-telephone", ActivityType.NoteAdded => "bi-chat-left-text", ActivityType.StageChanged => "bi-arrow-left-right", ActivityType.Assigned => "bi-person-plus", ActivityType.EmailSent => "bi-envelope", ActivityType.Created => "bi-plus-circle", _ => "bi-pencil" };
}
<div class="page-head">
  <div style="display:flex;gap:16px;align-items:center">
    <span class="avatar gold" style="width:56px;height:56px;font-size:18px">@UiHelpers.Initials(Model.FullName)</span>
    <div>
      <h2>@Model.FullName <button type="button" class="star-btn @(Model.Starred ? "is-on" : "")" data-star="@Model.Id" aria-label="Star lead"><i class="bi bi-star"></i></button></h2>
      <p>@Model.JobTitle@(Model.CompanyName != null ? " · " : "")@if (Model.CompanyId != null){<a asp-controller="Companies" asp-action="Details" asp-route-id="@Model.CompanyId" style="text-decoration:underline">@Model.CompanyName</a>}</p>
      <div style="display:flex;gap:8px;margin-top:8px;flex-wrap:wrap">
        <span class="badge @UiHelpers.StageBadge(Model.Stage)">@Model.Stage.Label()</span>
        @if (Model.OptedOut){<span class="badge badge-red">Unsubscribed</span>}
        @foreach (var t in Model.TagList){<span class="chip">@t</span>}
      </div>
    </div>
  </div>
  <div class="page-actions">
    @if (Model.CanEdit)
    {
      <a asp-controller="Tasks" asp-action="Create" asp-route-leadId="@Model.Id" class="btn btn-outline"><i class="bi bi-check2-square"></i> Add task</a>
      <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline"><i class="bi bi-pencil"></i> Edit</a>
    }
    @if (Model.CanDelete)
    {
      <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="inline-form" data-confirm="Delete this lead permanently? This cannot be undone.">
        <button type="submit" class="btn btn-danger-outline"><i class="bi bi-trash"></i> Delete</button>
      </form>
    }
  </div>
</div>

<div class="grid grid-12">
  <div class="span-4" style="display:flex;flex-direction:column;gap:20px">
    <div class="card">
      <div class="card-head"><h3>Deal</h3></div>
      <div class="card-pad">
        <div class="kpi-value" style="margin-bottom:14px">@UiHelpers.Money(Model.DealValue)</div>
        @if (Model.CanEdit)
        {
          <form asp-action="SetStage" asp-route-id="@Model.Id" method="post" class="field">
            <label>Stage</label>
            <div style="display:flex;gap:8px"><div class="select-wrap" style="flex:1"><select name="stage">@foreach (var s in Enum.GetValues<LeadStage>()){<option value="@((int)s)" selected="@(Model.Stage == s)">@s.Label()</option>}</select></div><button class="btn btn-outline btn-sm" type="submit">Update</button></div>
          </form>
          <form asp-action="Assign" asp-route-id="@Model.Id" method="post" class="field">
            <label>Owner</label>
            <div style="display:flex;gap:8px"><div class="select-wrap" style="flex:1"><select name="userId"><option value="">Unassigned</option>@foreach (var u in users){<option value="@u.Id" selected="@(Model.AssignedToId == u.Id)">@u.FullName</option>}</select></div><button class="btn btn-outline btn-sm" type="submit">Assign</button></div>
          </form>
        }
        else
        {
          <dl class="kv"><dt>Owner</dt><dd>@(Model.AssignedToName ?? "Unassigned")</dd></dl>
        }
        <dl class="kv" style="margin-top:8px">
          <dt>Next follow-up</dt><dd>@UiHelpers.RelativeDate(Model.NextFollowUp, false)</dd>
          <dt>Last contacted</dt><dd>@(Model.LastContactedUtc.HasValue ? UiHelpers.RelativeUtc(Model.LastContactedUtc.Value) : "Never")</dd>
          <dt>Source</dt><dd>@Model.Source.Label()</dd>
          <dt>Created</dt><dd>@UiHelpers.DateShort(Clock.ToLocal(Model.CreatedUtc))</dd>
        </dl>
      </div>
    </div>
    <div class="card">
      <div class="card-head"><h3>Contact</h3></div>
      <div class="card-pad"><dl class="kv">
        <dt>Email</dt><dd><a href="mailto:@Model.Email" style="text-decoration:underline">@Model.Email</a></dd>
        <dt>Phone</dt><dd>@if (!string.IsNullOrEmpty(Model.Phone)){<a href="tel:@Model.Phone">@Model.Phone</a>}else{<text>—</text>}</dd>
        <dt>Location</dt><dd>@(string.Join(", ", new[] { Model.City, Model.Province }.Where(x => !string.IsNullOrEmpty(x))) is { Length: > 0 } loc ? loc : "—")</dd>
        <dt>Preferred</dt><dd>@(Model.PreferredContact ?? "—")</dd>
        <dt>LinkedIn</dt><dd>@if (UiHelpers.IsSafeHttpUrl(Model.LinkedInUrl)){<a href="@Model.LinkedInUrl" target="_blank" rel="noopener noreferrer" style="text-decoration:underline">@UiHelpers.HostOf(Model.LinkedInUrl)</a>}else{<text>—</text>}</dd>
        <dt>Industry</dt><dd>@(Model.Industry ?? "—")</dd>
        <dt>Event</dt><dd>@if (Model.EventId != null){<a asp-controller="Events" asp-action="Details" asp-route-id="@Model.EventId" style="text-decoration:underline">@Model.EventName</a>}else{<text>—</text>}</dd>
      </dl></div>
    </div>
  </div>

  <div class="span-8" style="display:flex;flex-direction:column;gap:20px">
    @if (Model.CanEdit)
    {
      <div class="card">
        <div class="card-head"><h3>Log a call</h3></div>
        <form asp-action="LogCall" asp-route-id="@Model.Id" method="post" class="card-pad" novalidate>
          <div class="field-row">
            <div class="field"><label for="DurationMinutes">Duration (minutes)</label><input id="DurationMinutes" name="DurationMinutes" type="number" min="0" max="600" value="10"></div>
            <div class="field"><label for="NextFollowUpCall">Next follow-up</label><input id="NextFollowUpCall" name="NextFollowUp" type="date"></div>
          </div>
          <div class="field"><label for="Summary">What was discussed?</label><textarea id="Summary" name="Summary" maxlength="2000" required></textarea></div>
          <button type="submit" class="btn btn-green btn-sm"><i class="bi bi-telephone"></i> Log call</button>
        </form>
      </div>
    }
    <div class="card">
      <div class="tabs" data-tabs="leadTabs"><span class="tab active">Activity</span><span class="tab" data-tab-name="notes">Notes (@Model.Notes.Count)</span></div>
      <div id="leadTabs">
        <div class="tab-panel active card-pad">
          @if (Model.Activities.Count == 0){<p class="text-muted">No activity yet.</p>}
          <ul class="timeline">
            @foreach (var a in Model.Activities)
            {
              <li><span class="t-icon" style="background:var(--gold-100);color:var(--gold-700)"><i class="bi @IconFor(a.Type)"></i></span>
                <div class="t-body"><strong>@a.Title</strong>@if (!string.IsNullOrEmpty(a.Detail)){<p>@a.Detail</p>}<div class="t-time">@UiHelpers.RelativeUtc(a.CreatedUtc)@(a.UserName != null ? " · " + a.UserName : "")</div></div></li>
            }
          </ul>
        </div>
        <div class="tab-panel card-pad" id="notes">
          @if (Model.CanEdit)
          {
            <form asp-action="AddNote" asp-route-id="@Model.Id" method="post" novalidate style="margin-bottom:18px">
              <div class="field"><textarea name="Body" maxlength="4000" placeholder="Add a note…" required></textarea></div>
              <button type="submit" class="btn btn-green btn-sm"><i class="bi bi-plus-lg"></i> Add note</button>
            </form>
          }
          @if (Model.Notes.Count == 0){<p class="text-muted">No notes yet.</p>}
          @foreach (var n in Model.Notes)
          {
            <div style="padding:14px 0;border-top:1px solid var(--border-soft)"><div style="white-space:pre-wrap;font-size:13.5px">@n.Body</div><div class="t-time">@n.AuthorName · @UiHelpers.RelativeUtc(n.CreatedUtc)</div></div>
          }
        </div>
      </div>
    </div>
  </div>
</div>
