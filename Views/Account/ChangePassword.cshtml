@model ChangePasswordInput
@{ ViewData["Title"] = "Change password"; ViewData["ShowSearch"] = false; ViewData["Eyebrow"] = "Account"; }
<div class="content-narrow">
  @if (User.FindFirst("ug:mustchange")?.Value == "1")
  {
    <div class="flash info"><i class="bi bi-info-circle"></i> For your security, choose your own password before continuing.</div>
  }
  <partial name="_ValidationSummary" />
  <form asp-action="ChangePassword" method="post" class="card" novalidate>
    <div class="form-section">
      <h4>Change your password</h4>
      <p class="hint">Changing your password signs you out on all other devices.</p>
      <div class="field"><label asp-for="CurrentPassword">Current password</label><input asp-for="CurrentPassword" type="password" autocomplete="current-password" maxlength="128"></div>
      <div class="field"><label asp-for="NewPassword">New password</label><input asp-for="NewPassword" type="password" autocomplete="new-password" maxlength="128">
        <p class="field-help">At least @UncoveringGreatnessCRM.Security.PasswordService.MinLength characters with upper and lower case letters, a number and a symbol.</p></div>
      <div class="field"><label asp-for="ConfirmPassword">Confirm new password</label><input asp-for="ConfirmPassword" type="password" autocomplete="new-password" maxlength="128"></div>
    </div>
    <div class="form-actions"><button type="submit" class="btn btn-green"><i class="bi bi-check2"></i> Update password</button></div>
  </form>
</div>
