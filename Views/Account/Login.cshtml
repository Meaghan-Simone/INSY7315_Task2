@model LoginInput
@{ Layout = "_AuthLayout"; ViewData["Title"] = "Sign in"; }
<h2 style="font-size:22px;margin-bottom:6px">Welcome back</h2>
<p style="color:var(--text-500);font-size:13.5px;margin-bottom:26px">Sign in to your workspace to continue.</p>
<partial name="_ValidationSummary" />
<form asp-action="Login" method="post" autocomplete="on" novalidate>
  <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />
  <div class="field">
    <label asp-for="Email">Email address</label>
    <input asp-for="Email" type="email" placeholder="name@company.com" autocomplete="username" autofocus maxlength="200">
    <span asp-validation-for="Email" class="field-error"></span>
  </div>
  <div class="field">
    <div style="display:flex;justify-content:space-between"><label asp-for="Password">Password</label><a asp-action="ForgotPassword" style="font-size:12px;font-weight:600;color:var(--gold-700)">Forgot password?</a></div>
    <input asp-for="Password" type="password" placeholder="••••••••" autocomplete="current-password" maxlength="128">
  </div>
  <label class="check-row" style="margin-bottom:20px"><input asp-for="RememberMe" type="checkbox"><span style="font-size:13px;color:var(--text-600)">Keep me signed in on this device</span></label>
  <button type="submit" class="btn btn-green btn-block"><i class="bi bi-box-arrow-in-right"></i> Sign in</button>
</form>
<p style="text-align:center;font-size:12.5px;color:var(--text-400);margin-top:22px">Need access? Contact your workspace administrator.</p>
