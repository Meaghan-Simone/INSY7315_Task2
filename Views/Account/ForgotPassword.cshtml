@model ForgotPasswordInput
@{ Layout = "_AuthLayout"; ViewData["Title"] = "Reset password"; }
<h2 style="font-size:22px;margin-bottom:6px">Forgot your password?</h2>
@if (ViewData["Sent"] as bool? == true)
{
  <div class="flash success" style="margin-top:18px"><i class="bi bi-envelope-check"></i> If an account exists for that address, a reset link is on its way. It expires in 1 hour.</div>
  <a asp-action="Login" class="btn btn-outline btn-block" style="margin-top:8px">Back to sign in</a>
}
else
{
  <p style="color:var(--text-500);font-size:13.5px;margin-bottom:26px">Enter your work email and we'll send you a link to choose a new password.</p>
  <partial name="_ValidationSummary" />
  <form asp-action="ForgotPassword" method="post" novalidate>
    <div class="field"><label asp-for="Email">Email address</label><input asp-for="Email" type="email" autocomplete="username" autofocus maxlength="200"></div>
    <button type="submit" class="btn btn-green btn-block"><i class="bi bi-send"></i> Send reset link</button>
  </form>
  <p style="text-align:center;margin-top:20px"><a asp-action="Login" style="font-size:13px;font-weight:600;color:var(--gold-700)">Back to sign in</a></p>
}
