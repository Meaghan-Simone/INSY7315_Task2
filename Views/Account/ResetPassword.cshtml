@model ResetPasswordInput
@{ Layout = "_AuthLayout"; ViewData["Title"] = "Choose a new password"; }
<h2 style="font-size:22px;margin-bottom:6px">Choose a new password</h2>
<p style="color:var(--text-500);font-size:13.5px;margin-bottom:22px">Use at least @UncoveringGreatnessCRM.Security.PasswordService.MinLength characters with upper and lower case letters, a number and a symbol.</p>
<partial name="_ValidationSummary" />
<form asp-action="ResetPassword" method="post" novalidate>
  <input type="hidden" asp-for="Token" />
  <div class="field"><label asp-for="NewPassword">New password</label><input asp-for="NewPassword" type="password" autocomplete="new-password" autofocus maxlength="128"></div>
  <div class="field"><label asp-for="ConfirmPassword">Confirm new password</label><input asp-for="ConfirmPassword" type="password" autocomplete="new-password" maxlength="128"></div>
  <button type="submit" class="btn btn-green btn-block"><i class="bi bi-shield-lock"></i> Update password</button>
</form>
