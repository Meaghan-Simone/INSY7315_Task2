@{ ViewData["Title"] = "Access denied"; Layout = User.Identity?.IsAuthenticated == true ? "_Layout" : "_AuthLayout"; }
<div class="card"><div class="empty-state">
  <i class="bi bi-shield-lock"></i>
  <h4>You don't have access to that</h4>
  <p>Your role doesn't include this area. If you think that's a mistake, ask a workspace admin to review your permissions.</p>
  <a asp-controller="Home" asp-action="Index" class="btn btn-green">Back to dashboard</a>
</div></div>
