@model CompanyDetail
@{ ViewData["Title"] = Model.Name; ViewData["Eyebrow"] = "Company"; }
<div class="page-head">
  <div style="display:flex;gap:16px;align-items:center">
    <span class="avatar gold" style="width:56px;height:56px;font-size:18px">@UiHelpers.Initials(Model.Name)</span>
    <div><h2>@Model.Name</h2><p>@Model.Industry@(Model.City != null ? " · " + Model.City : "")@(Model.Size != null ? " · " + Model.Size + " employees" : "")</p></div>
  </div>
  <div class="page-actions">
    @if (Model.CanEdit)
    {
      <a asp-controller="Leads" asp-action="Create" asp-route-companyId="@Model.Id" class="btn btn-outline"><i class="bi bi-person-plus"></i> Add lead</a>
      <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline"><i class="bi bi-pencil"></i> Edit</a>
    }
    @if (Model.CanDelete)
    {
      <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="inline-form" data-confirm="Delete this company? This cannot be undone."><button type="submit" class="btn btn-danger-outline"><i class="bi bi-trash"></i> Delete</button></form>
    }
  </div>
</div>
<div class="grid grid-12">
  <div class="span-4" style="display:flex;flex-direction:column;gap:20px">
    <div class="grid grid-2">
      <div class="card kpi"><span class="kpi-label">Open pipeline</span><div class="kpi-value" style="font-size:21px">@UiHelpers.MoneyShort(Model.TotalPipeline)</div></div>
      <div class="card kpi"><span class="kpi-label">Closed won</span><div class="kpi-value" style="font-size:21px">@UiHelpers.MoneyShort(Model.WonValue)</div></div>
    </div>
    <div class="card"><div class="card-head"><h3>Details</h3></div><div class="card-pad"><dl class="kv">
      <dt>Website</dt><dd>@if (UiHelpers.IsSafeHttpUrl(Model.Website)){<a href="@Model.Website" target="_blank" rel="noopener noreferrer" style="text-decoration:underline">@UiHelpers.HostOf(Model.Website)</a>}else{<text>—</text>}</dd>
      <dt>Address</dt><dd>@(string.Join(", ", new[] { Model.AddressLine, Model.City, Model.Province }.Where(x => !string.IsNullOrEmpty(x))) is { Length: > 0 } a ? a : "—")</dd>
      <dt>Contact</dt><dd>@(Model.ContactPerson ?? "—")</dd>
      <dt>Phone</dt><dd>@(Model.ContactPhone ?? "—")</dd>
      <dt>Email</dt><dd>@if (!string.IsNullOrEmpty(Model.ContactEmail)){<a href="mailto:@Model.ContactEmail" style="text-decoration:underline">@Model.ContactEmail</a>}else{<text>—</text>}</dd>
    </dl>@if (!string.IsNullOrEmpty(Model.Notes)){<div class="divider"></div><div style="white-space:pre-wrap;font-size:13.5px">@Model.Notes</div>}</div></div>
  </div>
  <div class="card span-8">
    <div class="card-head"><h3>Leads (@Model.Leads.Count)</h3></div>
    @if (Model.Leads.Count == 0){<div class="empty-state"><i class="bi bi-people"></i><h4>No leads yet</h4><p>Leads linked to this company will appear here.</p></div>}
    else
    {
      <div class="table-wrap"><table><thead><tr><th>Lead</th><th>Stage</th><th class="text-right">Value</th><th>Owner</th></tr></thead><tbody>
      @foreach (var l in Model.Leads)
      {
        <tr class="row-link" data-href="@Url.Action("Details", "Leads", new { id = l.Id })"><td><div class="cell-name"><span class="avatar">@UiHelpers.Initials(l.FullName)</span><div><strong>@l.FullName</strong><span>@l.JobTitle</span></div></div></td>
          <td><span class="badge @UiHelpers.StageBadge(l.Stage)">@l.Stage.Label()</span></td><td class="text-right mono">@UiHelpers.Money(l.DealValue)</td><td class="text-muted">@(l.AssignedToName ?? "—")</td></tr>
      }
      </tbody></table></div>
    }
  </div>
</div>
