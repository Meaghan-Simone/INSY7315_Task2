@model CompanyInput
@{ ViewData["Title"] = "New company"; ViewData["Eyebrow"] = "Companies"; ViewData["ShowSearch"] = false; }
<div class="content-narrow"><form asp-action="Create" method="post" class="card" novalidate>
  <partial name="_Form" model="Model" />
  <div class="form-actions"><button type="submit" class="btn btn-green"><i class="bi bi-check2"></i> Create company</button><a asp-action="Index" class="btn btn-ghost">Cancel</a></div>
</form></div>
