@model CalendarInput
@{ ViewData["Title"] = "Edit calendar event"; ViewData["Eyebrow"] = "Calendar"; ViewData["ShowSearch"] = false; int id = ViewBag.EventId; }
<div class="content-narrow">
  <form asp-action="Edit" asp-route-id="@id" method="post" class="card" novalidate>
    <partial name="_Form" model="Model" />
    <div class="form-actions"><button type="submit" class="btn btn-green"><i class="bi bi-check2"></i> Save changes</button><a asp-action="Index" class="btn btn-ghost">Cancel</a></div>
  </form>
  <form asp-action="Delete" asp-route-id="@id" method="post" data-confirm="Delete this event?" style="margin-top:14px"><button type="submit" class="btn btn-danger-outline"><i class="bi bi-trash"></i> Delete event</button></form>
</div>
